llm:
  provider: openai
  api_key: sk-you-api-key-here
  base_url: https://api.openai.com/v1
  temperature: 0.7

  models:
    - id: gpt-4o
      name: GPT-4o
      reasoning: false
      input: ["text"]
      contextWindow: 128000
      maxTokens: 4096

