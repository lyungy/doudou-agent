llm:
  provider: openai
  api_key: sk-you-api-key-here
  base_url: https://api.openai.com/v1
  temperature: 0.7

  models:
    - id: gpt-4o
      name: GPT-4o
      reasoning: false
      input: ["text"]
      contextWindow: 128000
      maxTokens: 4096

    # - id: deepseek-chat
    #   name: DeepSeek Chat
    #   reasoning: false
    #   input: ["text"]
    #   contextWindow: 64000
    #   maxTokens: 4096

    # - id: mimo-v2.5-pro
    #   name: MiMo v2.5 Pro
    #   reasoning: true
    #   input: ["text"]
    #   contextWindow: 1048576
    #   maxTokens: 64000

# 存储配置
storage:
  data_dir: ./.doudou        # 数据目录，支持相对路径或绝对路径（如 ~/.doudou）

server:
  port: 3000

# 日志配置
logging:
  level: info              # debug | info | warn | error
  dir: ./logs              # 日志文件目录
  max_days: 7              # 保留天数，超过自动清理
