llm:
  thinking_level: medium   # off | minimal | low | medium | high | xhigh
  temperature: 0.7

  providers:
    # Provider 1: MiMo
    - name: MiMo
      provider: openai                          # API 协议（openai 兼容）
      api_key: sk-your-mimo-key
      base_url: https://token-plan-cn.xiaomimimo.com/v1
      models:
        - id: mimo-v2.5-pro
          name: MiMo v2.5 Pro
          reasoning: true
          input: ["text"]
          contextWindow: 1048576
          maxTokens: 64000

        - id: mimo-v2.5
          name: MiMo v2.5
          reasoning: true
          input: ["text", "image"]
          contextWindow: 262144
          maxTokens: 32000

    # Provider 2: DeepSeek（取消注释即可启用）
    # - name: DeepSeek
    #   provider: openai
    #   api_key: sk-your-deepseek-key
    #   base_url: https://api.deepseek.com/v1
    #   models:
    #     - id: deepseek-chat
    #       name: DeepSeek Chat
    #       reasoning: false
    #       input: ["text"]
    #       contextWindow: 64000
    #       maxTokens: 4096

    # Provider 3: 本地 Ollama
    # - name: Ollama
    #   provider: openai
    #   api_key: ollama
    #   base_url: http://localhost:11434/v1
    #   models:
    #     - id: llama3
    #       name: Llama 3
    #       reasoning: false
    #       input: ["text"]
    #       contextWindow: 8192
    #       maxTokens: 4096

# 存储配置
storage:
  data_dir: ./.doudou

# 服务器配置
server:
  port: 3000

# 客户端配置
client:
  port: 5173              # Vite dev server 端口

# 日志配置
logging:
  level: info              # debug | info | warn | error
  dir: ./logs              # 日志文件目录
  max_days: 7              # 保留天数，超过自动清理

# 上下文配置
context:
  max_context_tokens: 50000  # 历史消息截断的 token 预算上限，防止超长上下文撑爆 LLM context window
